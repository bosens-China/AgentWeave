{
  "name": "agentweave-cli",
  "version": "0.2.0",
  "description": "A local source of truth for coding agent resources",
  "author": "yliu",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentweave": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosens-China/AgentWeave.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.ts serve --dev",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm --workspace-root run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.22",
    "jsonc-parser": "^3.3.1",
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@agentweave/protocol": "workspace:*",
    "@types/proper-lockfile": "^4.1.4",
    "tsdown": "^0.23.7"
  }
}
