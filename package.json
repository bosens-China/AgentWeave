{
  "name": "agentweave-workspace",
  "private": true,
  "type": "module",
  "author": "yliu",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "setup": "pnpm install && tsx scripts/install-hooks.ts",
    "build": "pnpm --filter agentweave-cli run build && pnpm --filter @agentweave/web run build",
    "cli": "pnpm --filter agentweave-cli run cli",
    "ui": "pnpm --filter agentweave-cli run cli ui",
    "dev": "pnpm -r --parallel --filter agentweave-cli --filter @agentweave/web run dev",
    "dev:api": "pnpm --filter agentweave-cli run dev",
    "dev:web": "pnpm --filter @agentweave/web run dev",
    "docs:dev": "pnpm --filter @agentweave/docs run dev",
    "docs:build": "pnpm --filter @agentweave/docs run build",
    "docs:preview": "pnpm --filter @agentweave/docs run preview",
    "typecheck": "tsc --noEmit && pnpm -r run typecheck",
    "test": "vitest run",
    "format": "prettier --write apps packages scripts docs README.md package.json pnpm-workspace.yaml tsconfig.json vitest.config.ts --ignore-path .gitignore",
    "pack:cli": "pnpm --filter agentweave-cli pack --pack-destination dist"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "lint-staged": "16.4.0",
    "prettier": "3.8.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,css,html,json,md}": "prettier --write"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
